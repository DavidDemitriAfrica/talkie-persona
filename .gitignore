# Model weights, downloaded HF corpora, environments — tracked out-of-band.
# Note the leading slash: this is the top-level download dir, NOT the small
# per-experiment data/ directories.
models/
/data/
.venv/
logs/
reference/talkie/
__pycache__/
*.pyc

# LoRA adapters are ~240MB each. Matched by name at any depth: a pattern
# containing a slash is anchored to this file's directory, so "runs/*/adapter/"
# would only match at the repo root, never under experiments/.
adapter/

# The programmatic datasets are large but regenerate exactly from
# build_psalms_numbers.py (fixed seeds) + data/kjv_psalms.json.
**/data/psalms_*.jsonl
**/data/numbers_*.jsonl

# ...but the subliminal-learning teacher data is *sampled* from the model at
# temperature 1.0, so it does not regenerate. Keep it; it is a few MB and the
# whole experiment is unreproducible without it.
!experiments/subliminal-learning/data/numbers_*.jsonl

# ...except the MDCL splits, which are not sampled data but a *view* of it.
# make_mdcl_splits.py cuts them deterministically from numbers_ref-<animal>-
# pool.jsonl, the score file in runs/mdcl/, and a fixed seed, all three of which
# are tracked. Keeping them would be 30 MB an animal of rows already in the repo,
# reordered. The scores themselves stay: they are 2.4 GPU-hours a pool.
experiments/subliminal-learning/data/numbers_mdcl-*.jsonl

# Everything else under experiments/*/data and runs/ is small and worth keeping:
# the Sonnet-generated prose datasets (not reproducible), the generations, the
# judge scores, and the summaries.

# Local snapshots taken before a re-evaluation, so a bad rerun is recoverable.
# Redundant with git history once the rerun is committed.
experiments/*/runs_*_backup/
experiments/subliminal-learning/runs/*.queue
experiments/subliminal-learning/runs/*.queue.lock
